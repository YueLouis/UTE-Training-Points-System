# Copy these values into your local environment or deployment provider.
# Never commit real credentials or API keys.

SPRING_PROFILES_ACTIVE=production

# MySQL JDBC connection
DATABASE_URL=jdbc:mysql://localhost:3306/utetps?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USER=app
DB_PASSWORD=CHANGE_ME

# Authentication (at least 32 bytes; generate a unique random value)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# Password-reset email
RESEND_API_KEY=re_CHANGE_ME
MAIL_FROM=noreply@example.com
RESET_PEPPER=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET
RESET_TOKEN_EXPIRY=15
RESET_FRONTEND_URL=https://frontend.example.com/reset-password

# Comma-separated browser origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=https://frontend.example.com

PORT=8080
